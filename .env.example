# Preview/development only. Never put secrets in NEXT_PUBLIC_* variables.
# These two URLs MUST point to the same isolated Neon preview branch/database.
DATABASE_URL="postgresql://ROLE:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://ROLE:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# From the SAME branch's Managed Better Auth configuration.
NEON_AUTH_BASE_URL="https://ep-EXAMPLE.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# Exact local/preview origin, also allowlisted in Neon Auth.
APP_URL="http://localhost:3000"
# Match the branch's actual verification configuration: otp or link.
NEON_AUTH_EMAIL_VERIFICATION_METHOD="otp"
# Set only after recording permission for the actual catalog artwork source.
CATALOG_ARTWORK_CLEARED="0"

# Optional recommendation service; search/library/preferences do not need it.
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# One-time preview migration only. Remove/disable after verification.
MIGRATION_ENABLED="false"
MIGRATION_TARGET="preview"
MIGRATION_IDENTITY_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
# GOOGLE_APPLICATION_CREDENTIALS must be an absolute path OUTSIDE the repo.
# Set it only in the export shell, never on the web deployment.
